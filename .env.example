# Runtime configuration is environment variables only (workspace standard).
# Copy to .env — direnv loads it, and .env is gitignored.

# --- data sources -----------------------------------------------------------
# Read-only Postgres replica. The as-of feature matrix comes from here, because
# Postgres keeps one row per SCAN; OpenSearch keeps one document per file,
# overwritten, and mixes epochs. See specs/02-data.md.
POLYSCORE_DB_URI=postgresql+psycopg://user:pass@host:5432/dbname

# Optional. Local firehose dump for survey work — cohort selection, the
# composition table and split keys all run ~12x faster off disk than off the
# cluster. Not usable for the feature matrix (no engine identity).
POLYSCORE_FIREHOSE_DIR=

# --- run configuration ------------------------------------------------------
POLYSCORE_DATA_DIR=./data
POLYSCORE_RANDOM_SEED=20260922

# --- logging (workspace standard) -------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
